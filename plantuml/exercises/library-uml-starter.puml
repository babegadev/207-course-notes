@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Chapter 8, Question 1: UML class diagram for the library specification.
' The design decisions behind it are explained in library-analysis.md.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
'   Owner     o--> "*" Part ' aggregation:   Owner holds many Parts

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

' Only some items can be borrowed, so borrowing is an interface.
interface Borrowable {
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + checkOut(member : Member) : Loan
  + placeHold(member : Member) : Hold
}

' Books and DVDs differ only in loan period, so that is a field, not two
' subclasses. The factory methods keep the "book" / "DVD" intent readable.
class LendableItem {
  - loanPeriodDays : int
  - currentLoan : Loan
  - holds : List<Hold>
  + {static} book(title : String, catalogueNumber : String) : LendableItem
  + {static} dvd(title : String, catalogueNumber : String) : LendableItem
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + checkOut(member : Member) : Loan
  + placeHold(member : Member) : Hold
}

class ReferenceItem {
}

class Loan {
  - dueDate : LocalDate
  + getDueDate() : LocalDate
  + getMember() : Member
}

class Hold {
  - placedOn : LocalDate
  + getMember() : Member
}

class Catalogue {
  - items : Map<String, Item>
  + addItem(item : Item) : void
  + findItem(catalogueNumber : String) : Item
}

class Library {
  - members : Map<String, Member>
  + logIn(memberNumber : String) : Member
  + getCatalogue() : Catalogue
}

class Member {
  - memberNumber : String
  - lateFee : double
  + getMemberNumber() : String
  + getLateFee() : double
  + waiveLateFee() : void
  + placeHold(item : Borrowable) : Hold
}

' No common supertype with Member: the specification gives them no shared
' state or behaviour (librarians are not said to log in or borrow).
class Librarian {
  + addItem(catalogue : Catalogue, item : Item) : void
  + waiveLateFee(member : Member) : void
}

Item <|-- LendableItem
Item <|-- ReferenceItem
Borrowable <|.. LendableItem

Library *--> "1" Catalogue
Library o--> "*" Member
Catalogue o--> "*" Item

LendableItem --> "0..1" Loan : currentLoan
LendableItem --> "*" Hold : holds
Loan --> "1" Member
Hold --> "1" Member

Librarian ..> Catalogue : uses
Librarian ..> Member : uses
Borrowable <.. Member : uses

@enduml
